# Database Configuration
# Para PostgreSQL local no Windows:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guiaunico

# Para Supabase (recomendado para desenvolvimento):
# DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres

# Para Neon (alternativa em nuvem):
# DATABASE_URL=postgresql://[USUARIO]:[SENHA]@[HOST]/[DATABASE]?sslmode=require

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Reservado: hoje as sessões usam IDs aleatórios guardados no banco e este valor
# ainda não é lido pelo servidor. Defina um valor forte mesmo assim
# (ex.: openssl rand -base64 48) para quando for utilizado.
SESSION_SECRET=troque-por-um-valor-aleatorio

# Senha das contas de DESENVOLVIMENTO (admin e gerente), criadas em memória fora de produção.
# Se ficar vazia, uma senha aleatória é gerada e mostrada no console ao iniciar.
# Em produção essas contas não existem: crie o admin com `npm run create-admin`.
ADMIN_INITIAL_PASSWORD=

# SMTP Configuration (Opcional - para envio de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# WhatsApp Configuration (Opcional - para integração WhatsApp)
WHATSAPP_API_URL=https://api.whatsapp.business/v1
WHATSAPP_TOKEN=seu-token-whatsapp